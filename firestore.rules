rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.uid == "D7bvmKJAWLckfIKMyDA5p7vhlCn2";
    }

    function isOwner(uid) {
      return request.auth != null &&
        request.auth.uid == uid;
    }

    // users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }

    // admins collection
    match /admins/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }

    // businesses collection: public read for partner profile/names, owner or super admin write
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if isOwner(businessId) || isSuperAdmin();
    }

    // platform_catalog: super admin full access, public read
    match /platform_catalog/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // collection group match: allow public read of any 'modules' subcollection
    match /{path=**}/modules/{moduleId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // price_overrides: read-only for authenticated users, write locked to super admin
    match /price_overrides/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // business_modules: public read, business partner or super admin write
    match /business_modules/{businessId}/modules/{moduleId} {
      allow read: if true;
      allow write: if isOwner(businessId) || isSuperAdmin();
    }

    // quotes collection
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() &&
        (
          isSuperAdmin() ||
          request.auth.uid == resource.data.customerId ||
          request.auth.uid == resource.data.businessId
        );

      allow update, delete: if isAuthenticated() &&
        (isSuperAdmin() || request.auth.uid == resource.data.businessId);

      allow create: if isAuthenticated();
    }

  }
}
