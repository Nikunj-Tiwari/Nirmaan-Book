rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.uid == "QCukA84neKUuZrgF3PQ4ZmpkQx32";
    }

    function isOwner(uid) {
      return request.auth != null &&
        request.auth.uid == uid;
    }

    // users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }

    // admins collection
    match /admins/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }

    // businesses collection
    match /businesses/{businessId} {
      allow read, write: if isOwner(businessId) || isSuperAdmin();
    }

    // platform_catalog: super admin full access, authenticated users can read
    match /platform_catalog/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // price_overrides: read-only for authenticated users, write locked to super admin
    match /price_overrides/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // business_modules: business partners manage their own modules
    match /business_modules/{businessId}/modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(businessId) || isSuperAdmin();
    }

    // quotes collection
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() &&
        (
          isSuperAdmin() ||
          request.auth.uid == resource.data.customerId ||
          request.auth.uid == resource.data.businessId
        );

      allow update, delete: if isAuthenticated() &&
        (isSuperAdmin() || request.auth.uid == resource.data.businessId);

      allow create: if isAuthenticated();
    }

  }
}
